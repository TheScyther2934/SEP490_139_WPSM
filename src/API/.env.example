# Copy this file to src/API/.env and fill in the values. .env is git-ignored: never commit real secrets.
# Keys use "__" (two underscores) for nested settings. Empty values are ignored.

# Cloudinary (Dashboard -> API Keys): stores proof photos, receipts and supplier documents.
Cloudinary__CloudName=
Cloudinary__ApiKey=
Cloudinary__ApiSecret=

# Optional: database connection (Supabase Session pooler, .NET format). Leave empty to use User Secrets.
ConnectionStrings__WpsmDb=

# Email (Brevo SMTP relay). Smtp__User is the SMTP login, Smtp__Password the SMTP key; Smtp__From must be a sender verified in Brevo.
# Values with spaces or special characters go in single quotes, e.g. Smtp__From='WPSM <no-reply@example.com>'.
Smtp__Host=smtp-relay.brevo.com
Smtp__Port=587
Smtp__EnableSsl=true
Smtp__User=
Smtp__Password=
Smtp__From=

# Address put in email links (login, payments). Change it to the real site address when deployed.
Wpsm__PublicBaseUrl=http://localhost:5128