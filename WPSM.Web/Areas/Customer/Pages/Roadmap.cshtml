@page "/C03"
@{ ViewData["Title"] = "WPSM Portal — Lộ trình chuẩn bị hôn lễ (C-03)"; }
<div data-wpsm-screen="C03">

@await Html.PartialAsync("/Areas/Customer/Pages/Shared/_CustomerNavigation.cshtml")

<div class="ml-64 flex-1 flex flex-col min-h-screen bg-surface">

<!-- ═══════ TOP BAR ═══════════════════════════════════════════════════════ -->
<header class="sticky top-0 z-20 flex justify-between items-center w-full px-8 py-3.5 bg-surface-container-lowest border-b border-outline-variant/30 shadow-sm backdrop-blur-md">
  <div class="flex items-center gap-4">
    <nav class="flex items-center gap-2 text-body-sm font-body-sm text-on-surface-variant">
      <a href="/C01" class="hover:text-primary transition-colors">Tổng quan</a>
      <span class="text-outline-variant">/</span>
      <span class="font-semibold text-primary">Lộ trình chuẩn bị</span>
    </nav>
    <span class="px-2 py-0.5 rounded-full text-label-sm font-label-sm uppercase font-semibold bg-primary/10 text-primary border border-primary/20">C-03</span>
  </div>
  <div class="flex items-center gap-3">
    <span class="text-body-sm font-body-sm text-on-surface-variant" id="hdr-countdown">…</span>
    <div class="h-4 w-px bg-outline-variant/40"></div>
    <span class="text-title-sm font-title-sm font-semibold text-on-surface" id="hdr-couple">…</span>
  </div>
</header>

<!-- ═══════ LOADING STATE ════════════════════════════════════════════════ -->
<div id="state-loading" class="flex-1 flex items-center justify-center py-24">
  <div class="flex flex-col items-center gap-4 text-on-surface-variant">
    <span class="material-symbols-outlined text-[48px] animate-spin text-primary">progress_activity</span>
    <p class="text-body-md font-body-md">Đang tải lộ trình chuẩn bị…</p>
  </div>
</div>

<!-- ═══════ ERROR STATE ════════════════════════════════════════════════ -->
<div id="state-error" class="hidden flex-1 flex items-center justify-center py-24">
  <div class="flex flex-col items-center gap-4 text-center max-w-md">
    <span class="material-symbols-outlined text-[48px] text-error">cloud_off</span>
    <p class="text-title-md font-title-md text-on-surface">Không thể tải lộ trình</p>
    <p class="text-body-sm font-body-sm text-on-surface-variant" id="err-msg">Kiểm tra kết nối và thử lại.</p>
    <button onclick="loadRoadmap()" class="px-4 py-2 rounded-lg bg-primary text-on-primary font-title-sm text-title-sm">Thử lại</button>
  </div>
</div>

<!-- ═══════ MAIN CONTENT ═══════════════════════════════════════════════ -->
<div id="state-content" class="hidden flex-1 flex gap-0">

  <!-- ── Left: Timeline ──────────────────────────────────────────────── -->
  <div class="flex-1 px-8 py-6 space-y-5 max-w-4xl" id="timeline-column">

    <!-- Summary bar -->
    <div class="flex items-center justify-between pb-1">
      <h1 class="text-headline-sm font-headline-sm text-on-surface">Lộ trình chuẩn bị hôn lễ</h1>
      <div class="flex items-center gap-2">
        <button id="btn-collapse-done" onclick="collapseDoneGroups()"
          class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-lg border border-outline-variant/40 text-label-md font-label-md text-on-surface-variant hover:bg-surface-container transition-colors text-sm">
          <span class="material-symbols-outlined text-[16px]">compress</span>
          Thu gọn đã xong
        </button>
      </div>
    </div>

    <!-- Milestone groups — filled by JS -->
    <div id="milestone-list" class="space-y-4"></div>

    <!-- Empty roadmap -->
    <div id="roadmap-empty" class="hidden py-16 flex flex-col items-center gap-4 text-center">
      <span class="material-symbols-outlined text-[48px] text-on-surface-variant">timeline</span>
      <p class="text-title-md font-title-md text-on-surface">Lộ trình chưa được thiết lập</p>
      <p class="text-body-sm font-body-sm text-on-surface-variant">Ban điều phối sẽ tạo lộ trình sau khi hợp đồng được xác nhận.</p>
    </div>
  </div>

  <!-- ── Right: Progress Sidebar ─────────────────────────────────────── -->
  <aside class="w-72 border-l border-outline-variant/30 bg-surface-container-lowest py-6 px-5 hidden lg:flex flex-col gap-5 sticky top-[57px] h-[calc(100vh-57px)] overflow-y-auto">
    <!-- Overall progress -->
    <div>
      <div class="flex items-center justify-between mb-2">
        <span class="text-label-md font-label-md uppercase font-semibold text-primary tracking-wider">Tiến độ tổng</span>
        <span class="text-headline-sm font-headline-sm font-serif text-primary" id="prog-pct">—</span>
      </div>
      <div class="h-3 w-full bg-surface-container-high rounded-full overflow-hidden">
        <div class="h-full bg-primary rounded-full transition-all duration-700" id="prog-bar" style="width:0%"></div>
      </div>
      <p class="text-body-sm font-body-sm text-on-surface-variant mt-2 text-right" id="prog-label">—</p>
    </div>

    <!-- Milestone summary chips -->
    <div>
      <p class="text-label-md font-label-md uppercase font-semibold text-on-surface-variant tracking-wider mb-2">Theo nhóm</p>
      <div id="milestone-chips" class="space-y-2"></div>
    </div>

    <!-- Countdown -->
    <div class="mt-auto rounded-xl p-4 bg-gradient-to-br from-primary/10 to-primary/5 border border-primary/20">
      <p class="text-label-sm font-label-sm uppercase font-bold text-primary mb-1">Đếm ngược</p>
      <p class="text-headline-sm font-headline-sm font-serif text-on-surface" id="side-countdown">—</p>
      <p class="text-body-sm font-body-sm text-on-surface-variant mt-1" id="side-date">—</p>
    </div>
  </aside>

</div><!-- end state-content -->

<!-- ═══════ TASK DETAIL DIALOG ══════════════════════════════════════════ -->
<div id="task-dialog" class="fixed inset-0 z-50 hidden items-center justify-center p-4 bg-black/40 backdrop-blur-sm"
     onclick="if(event.target===this)closeDialog()">
  <div class="relative bg-surface-container-lowest rounded-2xl shadow-2xl w-full max-w-lg border border-outline-variant/30 overflow-hidden max-h-[90vh] flex flex-col">
    <!-- Dialog header -->
    <div class="flex items-start justify-between p-6 pb-4 border-b border-outline-variant/20">
      <div class="flex-1 pr-4">
        <div class="flex items-center gap-2 mb-1">
          <span class="px-2 py-0.5 rounded text-label-sm font-label-sm font-bold uppercase bg-primary/10 text-primary border border-primary/20" id="dlg-milestone">—</span>
          <span id="dlg-role-badge" class="px-2 py-0.5 rounded text-label-sm font-label-sm font-semibold uppercase"></span>
        </div>
        <h2 class="text-title-lg font-title-lg font-semibold text-on-surface" id="dlg-title">—</h2>
      </div>
      <button onclick="closeDialog()" class="shrink-0 p-1.5 rounded-lg text-on-surface-variant hover:bg-surface-container transition-colors">
        <span class="material-symbols-outlined text-[22px]">close</span>
      </button>
    </div>
    <!-- Dialog body -->
    <div class="flex-1 overflow-y-auto p-6 space-y-4">
      <!-- Info grid -->
      <div class="grid grid-cols-2 gap-3">
        <div class="p-3 rounded-lg bg-surface-container-low border border-outline-variant/20">
          <p class="text-label-sm font-label-sm text-on-surface-variant uppercase font-semibold mb-0.5">Hạn chót</p>
          <p class="text-body-md font-body-md text-on-surface font-semibold" id="dlg-due">—</p>
        </div>
        <div class="p-3 rounded-lg bg-surface-container-low border border-outline-variant/20">
          <p class="text-label-sm font-label-sm text-on-surface-variant uppercase font-semibold mb-0.5">Trạng thái</p>
          <p class="text-body-md font-body-md font-semibold" id="dlg-status">—</p>
        </div>
        <div class="p-3 rounded-lg bg-surface-container-low border border-outline-variant/20">
          <p class="text-label-sm font-label-sm text-on-surface-variant uppercase font-semibold mb-0.5">Phụ trách</p>
          <p class="text-body-md font-body-md text-on-surface" id="dlg-role">—</p>
        </div>
        <div class="p-3 rounded-lg bg-surface-container-low border border-outline-variant/20" id="dlg-completed-box">
          <p class="text-label-sm font-label-sm text-on-surface-variant uppercase font-semibold mb-0.5">Hoàn thành lúc</p>
          <p class="text-body-sm font-body-sm text-emerald-700 font-semibold" id="dlg-completed">—</p>
        </div>
      </div>
      <!-- Description / no description note -->
      <div>
        <p class="text-label-sm font-label-sm uppercase font-semibold text-on-surface-variant mb-2">Mô tả & hướng dẫn</p>
        <div class="p-3 rounded-lg bg-surface-container-low border border-outline-variant/20 text-body-sm font-body-sm text-on-surface-variant italic">
          Nhiệm vụ này chưa có mô tả chi tiết. Liên hệ Ban điều phối để biết thêm thông tin.
        </div>
      </div>
      <!-- Error message for complete action -->
      <div id="dlg-error" class="hidden p-3 rounded-lg bg-error-container text-on-error-container text-body-sm font-body-sm border border-error/20"></div>
    </div>
    <!-- Dialog footer -->
    <div class="p-6 pt-4 border-t border-outline-variant/20 flex items-center justify-between gap-3">
      <button onclick="closeDialog()" class="px-4 py-2 rounded-lg border border-outline-variant text-on-surface-variant font-title-sm text-title-sm hover:bg-surface-container transition-colors">
        Đóng
      </button>
      <!-- "Mark as Done" — only shown when task is Customer-owned and not yet Done -->
      <button id="dlg-complete-btn" onclick="confirmComplete()"
        class="hidden px-5 py-2.5 rounded-lg bg-primary text-on-primary font-title-sm text-title-sm hover:bg-primary/90 transition-colors inline-flex items-center gap-2 active:scale-[0.98] disabled:opacity-60 disabled:cursor-not-allowed">
        <span class="material-symbols-outlined text-[18px]">task_alt</span>
        <span id="dlg-complete-label">Xác nhận hoàn thành</span>
      </button>
    </div>
  </div>
</div><!-- end task-dialog -->

<!-- ═══════ FOOTER ═════════════════════════════════════════════════════ -->
<footer class="w-full py-4 border-t border-outline-variant/30 bg-surface-container-lowest">
  <div class="flex items-center justify-between px-8 py-1 text-body-sm font-body-sm text-on-surface-variant max-w-7xl mx-auto">
    <span class="text-title-sm font-title-sm text-primary font-semibold">WPSM Portal</span>
    <a href="tel:19008888" class="text-primary font-medium hover:underline flex items-center gap-1">
      <span class="material-symbols-outlined text-[16px]">call</span>1900 8888
    </a>
  </div>
</footer>

</div><!-- end ml-64 -->
</div><!-- end data-wpsm-screen -->

<!-- ═════════════════════════════════════════════════════════════════════════
     C-03 JAVASCRIPT — Roadmap + Task Detail + UC-06 Complete Task
     ════════════════════════════════════════════════════════════════════════ -->
<script>
(function () {
  'use strict';

  // ── State ─────────────────────────────────────────────────────────────────
  let _roadmap = null;          // CustomerRoadmapView from API
  let _activeTask = null;       // CustomerRoadmapTaskView currently in dialog
  let _completing = false;      // Guard against double-click

  // ── Helpers ───────────────────────────────────────────────────────────────
  function fmtDate(dateStr) {
    if (!dateStr) return '—';
    const [y, m, d] = String(dateStr).split('T')[0].split('-');
    return `${d}/${m}/${y}`;
  }

  function fmtDateTime(isoStr) {
    if (!isoStr) return '—';
    return new Date(isoStr).toLocaleString('vi-VN', {
      day: '2-digit', month: '2-digit', year: 'numeric',
      hour: '2-digit', minute: '2-digit'
    });
  }

  function statusHtml(status) {
    const cfg = {
      Done:    { color: 'text-emerald-700', icon: 'task_alt',       label: 'Đã hoàn thành' },
      Overdue: { color: 'text-red-700',     icon: 'warning',         label: 'Quá hạn' },
      Pending: { color: 'text-amber-700',   icon: 'hourglass_empty', label: 'Chờ thực hiện' }
    };
    const c = cfg[status] || cfg.Pending;
    return `<span class="inline-flex items-center gap-1 ${c.color} font-semibold">
      <span class="material-symbols-outlined text-[16px]">${c.icon}</span>${c.label}</span>`;
  }

  function statusDot(status) {
    return status === 'Done' ? 'bg-emerald-500 ring-2 ring-emerald-100'
         : status === 'Overdue' ? 'bg-red-500 ring-2 ring-red-100'
         : 'bg-amber-400 ring-2 ring-amber-100';
  }

  function show(id) { document.getElementById(id).classList.remove('hidden'); }
  function hide(id) { document.getElementById(id).classList.add('hidden'); }

  // ── Render full roadmap ───────────────────────────────────────────────────
  function render(data) {
    _roadmap = data;

    // Header
    document.getElementById('hdr-couple').textContent = data.coupleName;
    const cd = data.countdownDays;
    document.getElementById('hdr-countdown').textContent =
      cd === 0 ? 'Hôm nay — Ngày cưới!' : `Còn ${cd} ngày`;

    // Sidebar
    document.getElementById('side-countdown').textContent =
      cd === 0 ? 'Hôm nay — Ngày cưới!' : `Còn ${cd} ngày`;
    document.getElementById('side-date').textContent = 'Ngày cưới: ' + fmtDate(data.eventDate);

    const pct = data.totalTasks > 0
      ? Math.round((data.doneTasks / data.totalTasks) * 100) : 0;
    document.getElementById('prog-pct').textContent = pct + '%';
    document.getElementById('prog-bar').style.width = pct + '%';
    document.getElementById('prog-label').textContent = `${data.doneTasks} / ${data.totalTasks} nhiệm vụ`;

    // Milestone groups
    const list = document.getElementById('milestone-list');
    const chips = document.getElementById('milestone-chips');
    list.innerHTML = '';
    chips.innerHTML = '';

    const allGroupsEmpty = data.milestoneGroups.every(g => g.totalCount === 0);
    if (allGroupsEmpty) { show('roadmap-empty'); return; }

    data.milestoneGroups.forEach((group, gi) => {
      const isDone = group.doneCount === group.totalCount && group.totalCount > 0;
      const startCollapsed = isDone;

      // Chip in sidebar
      chips.innerHTML += `
        <div class="flex items-center justify-between p-2 rounded-lg bg-surface-container-low border border-outline-variant/20">
          <span class="text-body-sm font-body-sm font-semibold text-on-surface">${group.milestone}</span>
          <span class="text-label-sm font-label-sm ${isDone ? 'text-emerald-700 font-bold' : 'text-on-surface-variant'}">
            ${group.doneCount}/${group.totalCount}
          </span>
        </div>`;

      // Group card
      const groupEl = document.createElement('div');
      groupEl.id = `group-${gi}`;
      groupEl.className = 'rounded-xl border border-outline-variant/30 bg-surface-container-lowest shadow-sm overflow-hidden';
      groupEl.innerHTML = buildGroupHtml(group, gi, startCollapsed);
      list.appendChild(groupEl);
    });

    hide('state-loading');
    show('state-content');
  }

  function buildGroupHtml(group, gi, collapsed) {
    const isDone = group.doneCount === group.totalCount && group.totalCount > 0;
    const pct = group.totalCount > 0
      ? Math.round((group.doneCount / group.totalCount) * 100) : 0;

    const milestoneIcon = {
      'T-90': 'event_upcoming', 'T-30': 'event', 'T-7': 'event_note', 'Event Day': 'celebration'
    }[group.milestone] || 'check_circle';

    const headerBg = isDone ? 'bg-emerald-50 border-emerald-200'
      : 'bg-surface-container-low border-outline-variant/20';

    const tasksHtml = group.tasks.length === 0
      ? `<li class="py-4 text-center text-body-sm font-body-sm text-on-surface-variant">Nhóm này chưa có nhiệm vụ nào.</li>`
      : group.tasks.map(t => buildTaskRowHtml(t)).join('');

    return `
      <div class="border-b ${headerBg} cursor-pointer select-none"
           onclick="toggleGroup(${gi})" id="group-hdr-${gi}">
        <div class="flex items-center justify-between px-5 py-4 gap-4">
          <div class="flex items-center gap-3">
            <span class="material-symbols-outlined text-[22px] ${isDone ? 'text-emerald-600' : 'text-primary'}">${milestoneIcon}</span>
            <div>
              <div class="flex items-baseline gap-2">
                <h3 class="text-title-md font-title-md font-semibold text-on-surface">${group.milestone}</h3>
                ${isDone ? '<span class="text-label-sm font-label-sm text-emerald-700 font-bold bg-emerald-100 px-2 rounded-full border border-emerald-200">Đã xong</span>' : ''}
              </div>
              <p class="text-body-sm font-body-sm text-on-surface-variant mt-0.5">
                ${fmtDate(group.milestoneDate)} &nbsp;·&nbsp;
                ${group.doneCount}/${group.totalCount} nhiệm vụ hoàn thành
              </p>
            </div>
          </div>
          <div class="flex items-center gap-3 shrink-0">
            <!-- mini progress ring (text) -->
            <div class="text-right hidden sm:block">
              <span class="text-label-sm font-label-sm font-bold ${isDone ? 'text-emerald-700' : 'text-primary'}">${pct}%</span>
              <div class="w-20 h-1.5 bg-surface-container-high rounded-full overflow-hidden mt-1">
                <div class="h-full ${isDone ? 'bg-emerald-500' : 'bg-primary'} rounded-full transition-all" style="width:${pct}%"></div>
              </div>
            </div>
            <span class="material-symbols-outlined text-[20px] text-on-surface-variant transition-transform duration-200" id="chevron-${gi}">
              ${collapsed ? 'expand_more' : 'expand_less'}
            </span>
          </div>
        </div>
      </div>
      <!-- Task list -->
      <ul id="task-list-${gi}" class="${collapsed ? 'hidden' : ''} divide-y divide-outline-variant/20">
        ${tasksHtml}
      </ul>`;
  }

  function buildTaskRowHtml(task) {
    const roleLabel = task.assigneeRole === 'Customer' ? 'Khách hàng' : 'Ban điều phối';
    const completedNote = task.completedAt
      ? `<span class="text-emerald-600 ml-2 text-[11px]">✓ ${fmtDateTime(task.completedAt)}</span>` : '';
    return `
      <li class="flex items-center gap-3 px-5 py-3.5 hover:bg-surface-container/60 cursor-pointer transition-colors group"
          onclick="openTask(${task.taskId})" data-task-id="${task.taskId}">
        <span class="w-2.5 h-2.5 rounded-full shrink-0 mt-0.5 ${statusDot(task.status)}"></span>
        <div class="flex-1 min-w-0">
          <p class="text-title-sm font-title-sm text-on-surface font-semibold truncate">
            ${escHtml(task.title)}
          </p>
          <div class="flex flex-wrap items-center gap-2 mt-0.5 text-[11px] text-on-surface-variant">
            <span class="inline-flex items-center gap-0.5">
              <span class="material-symbols-outlined text-[13px]">calendar_today</span>
              ${fmtDate(task.dueDate)}
            </span>
            <span>·</span>
            <span class="inline-flex items-center gap-0.5">
              <span class="material-symbols-outlined text-[13px]">person</span>
              ${escHtml(roleLabel)}
            </span>
            ${completedNote}
          </div>
        </div>
        <div class="shrink-0 flex items-center gap-2">
          ${statusHtml(task.status)}
          <span class="material-symbols-outlined text-[18px] text-on-surface-variant opacity-0 group-hover:opacity-100 transition-opacity">chevron_right</span>
        </div>
      </li>`;
  }

  function escHtml(s) {
    return String(s).replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/"/g,'&quot;');
  }

  // ── Group collapse ─────────────────────────────────────────────────────────
  window.toggleGroup = function (gi) {
    const list = document.getElementById(`task-list-${gi}`);
    const chevron = document.getElementById(`chevron-${gi}`);
    const collapsed = list.classList.toggle('hidden');
    chevron.textContent = collapsed ? 'expand_more' : 'expand_less';
  };

  window.collapseDoneGroups = function () {
    if (!_roadmap) return;
    _roadmap.milestoneGroups.forEach((g, gi) => {
      const isDone = g.doneCount === g.totalCount && g.totalCount > 0;
      if (isDone) {
        const list = document.getElementById(`task-list-${gi}`);
        const chevron = document.getElementById(`chevron-${gi}`);
        if (list && !list.classList.contains('hidden')) {
          list.classList.add('hidden');
          chevron.textContent = 'expand_more';
        }
      }
    });
  };

  // ── Task Dialog ───────────────────────────────────────────────────────────
  window.openTask = function (taskId) {
    if (!_roadmap) return;
    // Find task in roadmap
    let found = null;
    for (const g of _roadmap.milestoneGroups) {
      found = g.tasks.find(t => t.taskId === taskId);
      if (found) break;
    }
    if (!found) return;
    _activeTask = found;
    showDialog(found);
  };

  function showDialog(task) {
    const isCustomerTask = task.assigneeRole === 'Customer';
    const canComplete = isCustomerTask && task.status !== 'Done';

    document.getElementById('dlg-milestone').textContent = task.milestone;
    document.getElementById('dlg-title').textContent = task.title;
    document.getElementById('dlg-due').textContent = fmtDate(task.dueDate);
    document.getElementById('dlg-status').innerHTML = statusHtml(task.status);
    document.getElementById('dlg-role').textContent =
      task.assigneeRole === 'Customer' ? 'Khách hàng' : 'Ban điều phối';

    // Role badge
    const roleBadge = document.getElementById('dlg-role-badge');
    if (isCustomerTask) {
      roleBadge.textContent = 'Của bạn';
      roleBadge.className = 'px-2 py-0.5 rounded text-label-sm font-label-sm font-semibold uppercase bg-primary/10 text-primary border border-primary/20';
    } else {
      roleBadge.textContent = 'Ban điều phối';
      roleBadge.className = 'px-2 py-0.5 rounded text-label-sm font-label-sm font-semibold uppercase bg-surface-container text-on-surface-variant border border-outline-variant/30';
    }

    // Completed timestamp
    if (task.completedAt) {
      document.getElementById('dlg-completed').textContent = fmtDateTime(task.completedAt);
      show('dlg-completed-box');
    } else {
      hide('dlg-completed-box');
    }

    // Complete button
    const btn = document.getElementById('dlg-complete-btn');
    if (canComplete) {
      btn.classList.remove('hidden');
      btn.disabled = false;
      document.getElementById('dlg-complete-label').textContent = 'Xác nhận hoàn thành';
    } else {
      btn.classList.add('hidden');
    }

    hide('dlg-error');
    const dialog = document.getElementById('task-dialog');
    dialog.classList.remove('hidden');
    dialog.classList.add('flex');
    document.body.style.overflow = 'hidden';
  }

  window.closeDialog = function () {
    document.getElementById('task-dialog').classList.add('hidden');
    document.getElementById('task-dialog').classList.remove('flex');
    document.body.style.overflow = '';
    _activeTask = null;
    _completing = false;
  };

  // Keyboard ESC
  document.addEventListener('keydown', e => { if (e.key === 'Escape') closeDialog(); });

  // ── UC-06: Complete Task ──────────────────────────────────────────────────
  window.confirmComplete = async function () {
    if (!_activeTask || _completing) return;
    _completing = true;

    const btn = document.getElementById('dlg-complete-btn');
    const label = document.getElementById('dlg-complete-label');
    btn.disabled = true;
    label.textContent = 'Đang xử lý…';
    hide('dlg-error');

    try {
      const projectCode = _roadmap.projectCode;
      const taskId = _activeTask.taskId;
      const res = await fetch(
        `/api/wpsm/customer/projects/${encodeURIComponent(projectCode)}/roadmap/tasks/${taskId}/complete`,
        { method: 'POST', credentials: 'same-origin' }
      );

      if (!res.ok) {
        const body = await res.json().catch(() => ({}));
        throw new Error(body.error || `Lỗi HTTP ${res.status}`);
      }

      const result = await res.json();
      if (!result.success) throw new Error(result.message);

      // Update in-memory state and re-render task row + dialog
      updateTaskInState(result.updatedTask);
      showDialog(result.updatedTask);
      _activeTask = result.updatedTask;

    } catch (err) {
      const errEl = document.getElementById('dlg-error');
      errEl.textContent = err.message || 'Có lỗi xảy ra. Vui lòng thử lại.';
      errEl.classList.remove('hidden');
      btn.disabled = false;
      label.textContent = 'Thử lại';
    } finally {
      _completing = false;
    }
  };

  // Patch task in _roadmap state + update its DOM row without full reload
  function updateTaskInState(updatedTask) {
    if (!_roadmap) return;
    for (const g of _roadmap.milestoneGroups) {
      const idx = g.tasks.findIndex(t => t.taskId === updatedTask.taskId);
      if (idx >= 0) {
        g.tasks[idx] = updatedTask;
        // Recalculate group doneCount
        g.doneCount = g.tasks.filter(t => t.status === 'Done').length;
        break;
      }
    }
    // Recalculate totals
    _roadmap.doneTasks = _roadmap.milestoneGroups.reduce((sum, g) => sum + g.doneCount, 0);

    // Re-render only the affected task row
    const rowEl = document.querySelector(`[data-task-id="${updatedTask.taskId}"]`);
    if (rowEl) rowEl.outerHTML = buildTaskRowHtml(updatedTask);

    // Update progress in sidebar
    const pct = _roadmap.totalTasks > 0
      ? Math.round((_roadmap.doneTasks / _roadmap.totalTasks) * 100) : 0;
    document.getElementById('prog-pct').textContent = pct + '%';
    document.getElementById('prog-bar').style.width = pct + '%';
    document.getElementById('prog-label').textContent =
      `${_roadmap.doneTasks} / ${_roadmap.totalTasks} nhiệm vụ`;
  }

  // ── Fetch & boot ──────────────────────────────────────────────────────────
  async function loadRoadmap() {
    hide('state-error');
    show('state-loading');
    hide('state-content');

    try {
      const res = await fetch('/api/wpsm/customer/roadmap', { credentials: 'same-origin' });
      if (res.status === 404) {
        hide('state-loading');
        document.getElementById('err-msg').textContent = 'Chưa có dự án hôn lễ nào được gắn với tài khoản.';
        show('state-error');
        return;
      }
      if (!res.ok) throw new Error(`HTTP ${res.status}`);
      const data = await res.json();
      render(data);
    } catch (err) {
      hide('state-loading');
      const el = document.getElementById('err-msg');
      if (el) el.textContent = err.message || 'Lỗi kết nối máy chủ.';
      show('state-error');
      console.error('[C03]', err);
    }
  }

  // Expose for retry button
  window.loadRoadmap = loadRoadmap;
  loadRoadmap();
})();
</script>
