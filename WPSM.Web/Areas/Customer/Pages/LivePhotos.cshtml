@page "/C11"
@{ ViewData["Title"] = "WPSM Portal — Ảnh thực tế hôn lễ (C-11)"; }
<div data-wpsm-screen="C11">

@await Html.PartialAsync("/Areas/Customer/Pages/Shared/_CustomerNavigation.cshtml")

<div class="ml-64 flex-1 flex flex-col">
<header class="sticky top-0 z-20 flex justify-between items-center w-full px-8 py-3.5 bg-surface-container-lowest border-b border-outline-variant/30 shadow-sm">
  <div class="flex items-center gap-4">
    <nav class="flex items-center gap-2 text-body-sm font-body-sm text-on-surface-variant">
      <a href="/C01" class="hover:text-primary transition-colors">Tổng quan</a>
      <span class="text-outline-variant">/</span>
      <span class="font-semibold text-primary">Ảnh thực tế hôn lễ</span>
    </nav>
    <span class="px-2 py-0.5 rounded-full text-label-sm font-label-sm uppercase font-semibold bg-primary/10 text-primary border border-primary/20">MÃ: C-11</span>
  </div>
</header>

<main class="flex-1 px-8 py-6 max-w-7xl w-full mx-auto" id="c11-main">
  <!-- Loading -->
  <div id="photos-loading" class="flex items-center justify-center py-20">
    <span class="material-symbols-outlined text-[48px] animate-spin text-primary">progress_activity</span>
  </div>
  <!-- Photo grid — filled by JS -->
  <div id="photos-grid" class="hidden">
    <div class="flex items-center gap-3 mb-6">
      <span class="material-symbols-outlined text-primary text-[28px]">photo_library</span>
      <h1 class="text-headline-sm font-headline-sm text-on-surface">Ảnh thực tế hôn lễ</h1>
    </div>
    <div class="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-4 gap-4" id="photos-container"></div>
  </div>
  <!-- Empty state -->
  <div id="photos-empty" class="hidden flex flex-col items-center justify-center py-24 gap-6 text-center">
    <div class="p-5 rounded-2xl bg-surface-container-low border border-outline-variant/20">
      <span class="material-symbols-outlined text-[64px] text-on-surface-variant">photo_camera_back</span>
    </div>
    <h1 class="text-headline-md font-headline-md text-on-surface">Chưa có ảnh nào</h1>
    <p class="text-body-lg font-body-lg text-on-surface-variant max-w-md">
      Ảnh thực tế sẽ được tải lên bởi Ban điều phối vào ngày diễn ra hôn lễ.
    </p>
    <a href="/C01" class="inline-flex items-center gap-2 px-5 py-2.5 rounded-lg bg-primary text-on-primary font-title-sm text-title-sm hover:bg-primary/90 transition-colors">
      <span class="material-symbols-outlined text-[18px]">arrow_back</span>Quay lại Tổng quan
    </a>
  </div>
</main>

<footer class="w-full py-4 border-t border-outline-variant/30 bg-surface-container-lowest mt-auto">
  <div class="flex items-center justify-between px-8 py-2 text-body-sm font-body-sm text-on-surface-variant">
    <span class="text-title-sm font-title-sm text-primary font-semibold">WPSM Portal</span>
    <a href="tel:19008888" class="text-primary font-medium hover:underline flex items-center gap-1">
      <span class="material-symbols-outlined text-[16px]">call</span>1900 8888
    </a>
  </div>
</footer>
</div>
</div>

<script>
(function () {
  // C-11 loads the latest proof photo via the same dashboard API,
  // and renders individual photos using /api/wpsm/customer/photos/{id}
  async function loadPhotos() {
    try {
      const res = await fetch('/api/wpsm/customer/dashboard', { credentials: 'same-origin' });
      if (!res.ok) throw new Error(`HTTP ${res.status}`);
      const d = await res.json();

      document.getElementById('photos-loading').classList.add('hidden');

      if (!d.latestProofPhoto) {
        document.getElementById('photos-empty').classList.remove('hidden');
        return;
      }

      const grid = document.getElementById('photos-grid');
      const container = document.getElementById('photos-container');
      const p = d.latestProofPhoto;
      const photoUrl = `/api/wpsm/customer/photos/${p.photoId}`;
      const uploadedAt = new Date(p.uploadedAt).toLocaleDateString('vi-VN');

      container.innerHTML = `
        <div class="group rounded-xl overflow-hidden border border-outline-variant/30 bg-surface-container-low shadow-sm hover:shadow-md transition-shadow">
          <div class="relative h-56 overflow-hidden">
            <img src="${photoUrl}" alt="Ảnh hôn lễ"
              class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-300"
              onerror="this.closest('.group').innerHTML='<div class=\\'flex items-center justify-center h-56 bg-surface-container-high\\'><span class=\\'material-symbols-outlined text-[48px] text-on-surface-variant\\'>image_not_supported</span></div>'"
            />
          </div>
          <div class="p-3">
            <p class="text-title-sm font-title-sm text-on-surface font-semibold">Ảnh chuẩn bị hôn lễ</p>
            <p class="text-[11px] text-on-surface-variant mt-1 flex items-center gap-1">
              <span class="material-symbols-outlined text-[13px]">person</span>${p.uploaderName}
            </p>
            <p class="text-[11px] text-on-surface-variant mt-0.5">${uploadedAt}</p>
          </div>
        </div>`;

      grid.classList.remove('hidden');
    } catch (e) {
      document.getElementById('photos-loading').classList.add('hidden');
      document.getElementById('photos-empty').classList.remove('hidden');
      console.error('[C11]', e);
    }
  }

  loadPhotos();
})();
</script>
