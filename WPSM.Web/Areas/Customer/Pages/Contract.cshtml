@page "/C02"
@{ ViewData["Title"] = "WPSM Portal - Hợp đồng & Đặc tả Chi tiết (C-02)"; }
<div data-wpsm-screen="C02">
    @await Html.PartialAsync("/Areas/Customer/Pages/Shared/_CustomerNavigation.cshtml")

    <header class="ml-64 sticky top-0 z-20 flex flex-wrap items-center justify-between gap-4 border-b border-outline-variant/30 bg-surface-container-lowest px-6 py-3 shadow-sm">
        <div class="flex flex-wrap items-center gap-3">
            <div class="text-label-md text-on-surface-variant">Trang chủ <span class="mx-1 text-outline-variant">/</span> Hồ sơ tiệc cưới <span class="mx-1 text-outline-variant">/</span> <span class="font-medium text-primary">Hợp đồng &amp; đặc tả</span></div>
            <span class="rounded-md border border-outline-variant/40 bg-surface-container-low px-2.5 py-1 font-label-md text-label-md text-on-surface">Mã: <strong data-c02="project-code">Đang tải…</strong></span>
            <span class="rounded-md border border-secondary/30 bg-secondary-fixed/30 px-2.5 py-1 font-label-md text-label-md font-semibold text-secondary"><span class="material-symbols-outlined align-middle text-[14px]">diamond</span> <span data-c02="hall">—</span></span>
            <span class="rounded-md border border-outline-variant/40 bg-surface-container-low px-2.5 py-1 font-label-md text-label-md text-on-surface"><span class="material-symbols-outlined align-middle text-[14px]">calendar_today</span> <span data-c02="event-date">—</span></span>
        </div>
        <div class="flex items-center gap-3 text-sm text-on-surface-variant">
            <span class="font-semibold text-primary" data-c02="couple-name">WPSM Portal</span>
            <span>Khách hàng</span>
        </div>
    </header>

    <main class="ml-64 max-w-[1280px] space-y-6 p-6 md:p-8">
        <section class="flex flex-col justify-between gap-4 md:flex-row md:items-end">
            <div class="space-y-2">
                <div class="flex flex-wrap items-center gap-2">
                    <span class="rounded bg-primary-container px-2 py-0.5 text-[11px] font-bold uppercase tracking-wider text-on-primary">Mã: C-02</span>
                    <span class="inline-flex items-center gap-1 rounded-full border border-outline-variant/40 bg-surface-container-high px-2.5 py-0.5 text-xs text-on-surface-variant"><span class="material-symbols-outlined text-[14px]">visibility</span> Chế độ: Khách hàng (Chỉ đọc)</span>
                    <span data-c02="baseline-status" class="inline-flex items-center gap-1 rounded-full border px-3 py-1 text-label-md font-semibold"></span>
                </div>
                <h1 class="font-headline-lg text-headline-lg font-semibold tracking-tight text-primary">Hợp đồng &amp; đặc tả chi tiết</h1>
                <p class="max-w-3xl text-body-md text-on-surface-variant" data-c02="status-description">Đang tải thông tin hợp đồng…</p>
            </div>
            <div class="flex flex-wrap items-center gap-2">
                <button type="button" disabled title="Chức năng tải hợp đồng PDF chưa được cung cấp" class="inline-flex cursor-not-allowed items-center gap-2 rounded-lg border border-outline-variant/50 px-3.5 py-2 font-title-sm text-title-sm text-on-surface-variant opacity-60"><span class="material-symbols-outlined text-[18px]">download</span> Tải bản in hợp đồng</button>
                <button type="button" disabled title="Màn hình phụ lục hợp đồng thuộc phạm vi C-09" class="inline-flex cursor-not-allowed items-center gap-2 rounded-lg border border-secondary/40 px-3.5 py-2 font-title-sm text-title-sm text-secondary opacity-60"><span class="material-symbols-outlined text-[18px]">attach_file</span> Phụ lục hợp đồng <span data-c02="addenda-count" class="rounded-full bg-secondary px-1.5 py-0.5 text-[11px] font-bold text-on-secondary">—</span></button>
            </div>
        </section>

        <section class="overflow-hidden rounded-xl border border-outline-variant/30 bg-surface-container-lowest shadow-sm" aria-label="Tóm tắt hợp đồng gốc">
            <div class="grid grid-cols-1 divide-y divide-outline-variant/30 sm:grid-cols-2 sm:divide-y-0 lg:grid-cols-4 lg:divide-x">
                <article class="p-5">
                    <p class="mb-2 flex items-center justify-between text-label-md text-on-surface-variant">Sảnh tiệc <span class="material-symbols-outlined text-primary">room_preferences</span></p>
                    <h2 class="font-title-lg text-title-lg font-semibold text-primary" data-c02="summary-hall">—</h2>
                    <p class="mt-1 text-body-sm text-on-surface-variant">Địa điểm tổ chức theo hợp đồng</p>
                </article>
                <article class="p-5">
                    <p class="mb-2 flex items-center justify-between text-label-md text-on-surface-variant">Ca tiệc <span class="material-symbols-outlined text-secondary">schedule</span></p>
                    <h2 class="font-title-lg text-title-lg font-semibold text-on-surface" data-c02="slot">—</h2>
                    <p class="mt-1 text-body-sm text-on-surface-variant">Khung giờ đã đặt</p>
                </article>
                <article class="p-5">
                    <p class="mb-2 flex items-center justify-between text-label-md text-on-surface-variant">Ngày tổ chức <span class="material-symbols-outlined text-primary">celebration</span></p>
                    <h2 class="font-title-lg text-title-lg font-semibold text-on-surface" data-c02="summary-date">—</h2>
                    <p class="mt-1 text-body-sm text-on-surface-variant" data-c02="days-left"></p>
                </article>
                <article class="bg-surface-container-low/50 p-5">
                    <p class="mb-2 flex items-center justify-between text-label-md font-semibold text-primary">Giá trị hợp đồng gốc <span class="material-symbols-outlined">verified</span></p>
                    <h2 class="font-title-lg text-title-lg font-bold tracking-tight text-primary" data-c02="base-value">—</h2>
                    <p class="mt-1 text-body-sm text-on-surface-variant">Giá trị ghi nhận khi khởi tạo dự án</p>
                </article>
            </div>
            <div class="flex flex-col justify-between gap-3 border-t border-outline-variant/30 bg-surface-container-high/50 px-5 py-4 sm:flex-row sm:items-center">
                <div>
                    <p class="font-title-sm text-title-sm font-semibold text-on-surface">Tiền đặt cọc không hoàn lại (NRD): <strong class="text-primary" data-c02="nrd-amount">—</strong></p>
                    <p class="mt-1 text-body-sm text-on-surface-variant">Trạng thái: <span data-c02="nrd-status">—</span></p>
                </div>
                <span class="rounded-full border border-outline-variant/40 bg-white px-3 py-1 text-label-sm font-semibold text-on-surface-variant" data-c02="frozen-at">Chưa đóng băng</span>
            </div>
        </section>

        <section class="flex items-start gap-3 rounded-xl border border-primary-container/20 bg-surface-container-low p-4">
            <span class="material-symbols-outlined mt-0.5 rounded-lg bg-primary-fixed p-1.5 text-primary">lock</span>
            <div class="text-body-sm text-on-surface-variant">
                <h2 class="mb-1 font-title-sm text-title-sm font-semibold text-primary">Bảo lưu hợp đồng gốc</h2>
                <p>Đặc tả trong phần này được hiển thị để đối chiếu và không thể chỉnh sửa từ tài khoản khách hàng. Nhu cầu thay đổi hợp đồng được tiếp nhận qua quy trình yêu cầu thay đổi sau khi màn hình tương ứng được triển khai.</p>
            </div>
        </section>

        <section class="overflow-hidden rounded-xl border border-outline-variant/30 bg-surface-container-lowest shadow-sm">
            <header class="flex flex-col justify-between gap-2 border-b border-outline-variant/30 p-5 sm:flex-row sm:items-center">
                <div>
                    <h2 class="font-headline-sm text-headline-sm text-primary">Đặc tả chi tiết theo nhóm</h2>
                    <p class="mt-1 text-body-sm text-on-surface-variant">Danh sách hạng mục và đơn giá của hợp đồng gốc.</p>
                </div>
                <span class="rounded-full border border-outline-variant/40 bg-surface-container-low px-3 py-1 text-label-md text-on-surface-variant" data-c02="item-count">Đang tải…</span>
            </header>
            <div data-c02="specification-groups" class="divide-y divide-outline-variant/30" aria-live="polite">
                <p class="p-6 text-center text-body-md text-on-surface-variant">Đang tải đặc tả…</p>
            </div>
            <footer class="border-t border-outline-variant/40 bg-surface-container-low p-5">
                <div class="ml-auto max-w-md space-y-2">
                    <div class="flex items-center justify-between gap-4 text-body-md"><span class="text-on-surface-variant">Tổng giá trị các hạng mục đang hiển thị</span><strong class="text-on-surface" data-c02="spec-total">—</strong></div>
                    <div class="flex items-center justify-between gap-4 border-t border-outline-variant/40 pt-2 text-title-md"><span class="font-bold text-primary">Giá trị hợp đồng gốc</span><strong class="font-headline-sm text-headline-sm text-primary" data-c02="base-value-total">—</strong></div>
                </div>
            </footer>
        </section>
    </main>
</div>
