  <!-- 3. PROOF-OF-EXECUTION PHOTOS -->
  <section class="rounded-xl bg-surface-container-lowest border border-outline-variant/30 p-6 shadow-sm">
    <div class="flex flex-col md:flex-row md:items-center justify-between pb-4 border-b border-outline-variant/20 mb-5 gap-2">
      <div>
        <div class="flex items-center gap-2">
          <span class="material-symbols-outlined text-primary text-[22px]">photo_library</span>
          <h2 class="text-title-lg font-title-lg font-semibold text-on-surface">Ảnh chuẩn bị mới nhất</h2>
        </div>
        <p class="text-body-sm font-body-sm text-on-surface-variant mt-0.5">Hình ảnh thi công, trang trí và hậu trường chuẩn bị từ Ban điều phối</p>
