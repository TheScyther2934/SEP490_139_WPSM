</footer>

</div><!-- end ml-64 -->
</div><!-- end data-wpsm-screen -->

<!-- ========================================================================= -->
<!-- C-01 JAVASCRIPT — fetch real data, no mock                                -->
<!-- ========================================================================= -->
<script>
(function () {
  'use strict';

  // ── Helpers ────────────────────────────────────────────────────────────────
  function fmtDate(dateStr) {
    // dateStr is "YYYY-MM-DD" from JSON
    if (!dateStr) return '—';
    const [y, m, d] = dateStr.split('-');
    return `${d}/${m}/${y}`;
  }

  function fmtVnd(amount) {
    if (amount == null) return '—';
    return new Intl.NumberFormat('vi-VN', { style: 'currency', currency: 'VND' }).format(amount);
  }

  function show(id) { document.getElementById(id).classList.remove('hidden'); }
  function hide(id) { document.getElementById(id).classList.add('hidden'); }

  // ── Render ─────────────────────────────────────────────────────────────────
  function render(d) {
    // Header chips
    document.getElementById('hdr-code').textContent = d.projectCode;
    document.getElementById('hdr-hall').textContent = d.hall;
    document.getElementById('hdr-date').textContent = fmtDate(d.eventDate);
    document.getElementById('hdr-name').textContent = d.coupleName;

    // Countdown banner
    document.getElementById('banner-couple').textContent = d.coupleName;
    document.getElementById('banner-hall').textContent = d.hall;
    document.getElementById('banner-slot').textContent = d.slot;
    document.getElementById('banner-date').textContent = fmtDate(d.eventDate);
    document.getElementById('countdown-label').textContent = d.countdownLabel;
    document.getElementById('countdown-date').textContent =
      'Ngày sự kiện: ' + fmtDate(d.eventDate);

    // Tasks
    const tasks = d.upcomingTasks || [];
    const taskList = document.getElementById('task-list');
    const taskBadge = document.getElementById('task-badge');
    const taskEmpty = document.getElementById('task-empty');

    const pending = tasks.filter(t => t.status !== 'Done');
    if (pending.length > 0) {
      taskBadge.textContent = pending.length + ' việc cần làm';
      taskBadge.classList.remove('hidden');
    }

    if (tasks.length === 0) {
      show('task-empty');
    } else {
      taskList.innerHTML = tasks.map(t => {
        const statusColor = t.status === 'Done' ? 'bg-emerald-500 ring-2 ring-emerald-100'
          : t.status === 'Overdue' ? 'bg-red-500 ring-2 ring-red-100'
          : 'bg-amber-500 ring-2 ring-amber-200';
        const statusText = t.status === 'Done' ? '<span class="text-emerald-700 font-medium">Đã xong</span>'
          : t.status === 'Overdue' ? '<span class="text-red-700 font-medium">Quá hạn</span>'
          : '<span>Chờ thực hiện</span>';
        const milestoneLabel = t.milestone ? `<span class="text-[10px] px-1.5 rounded bg-primary/10 text-primary font-semibold">${t.milestone}</span>` : '';
        return `<li class="p-2.5 rounded-lg bg-surface-container-low border border-outline-variant/20 flex items-start gap-2.5">
          <span class="w-2.5 h-2.5 rounded-full ${statusColor} mt-1.5 shrink-0"></span>
          <div class="flex-1 min-w-0">
            <p class="text-title-sm font-title-sm text-on-surface font-semibold truncate flex items-center gap-1.5">
              ${t.title} ${milestoneLabel}
            </p>
            <div class="flex items-center gap-2 mt-0.5 text-[11px] text-on-surface-variant">
              <span>Hạn: <strong>${fmtDate(t.dueDate)}</strong></span>
              <span>•</span>
              ${statusText}
            </div>
          </div>
          <a href="/C03" class="shrink-0 text-[11px] text-primary hover:underline">Chi tiết</a>
        </li>`;
      }).join('');
    }

    // CRs
    const crCount = d.openCrCount || 0;
    document.getElementById('cr-count').textContent = crCount;
    if (crCount === 0) {
      show('cr-empty');
    } else {
      show('cr-hint');
    }

    // Balance
    const base = d.baseContractValue || 0;
    const paid = d.totalPaid || 0;
    const outstanding = d.outstandingBalance || 0;
    const paidPct = base > 0 ? Math.min(100, Math.round((paid / base) * 100)) : 0;

    document.getElementById('balance-outstanding').textContent = fmtVnd(outstanding);
    document.getElementById('balance-paid').textContent = fmtVnd(paid);
    document.getElementById('balance-total').textContent = fmtVnd(base);
    document.getElementById('balance-bar').style.width = paidPct + '%';

    const rp = d.roadmapProgress || 0;
    document.getElementById('roadmap-pct').textContent = rp + '%';
    document.getElementById('roadmap-bar').style.width = rp + '%';

    // Photos
    const photoArea = document.getElementById('photo-area');
    if (d.latestProofPhoto) {
      const p = d.latestProofPhoto;
      const uploadedAt = new Date(p.uploadedAt).toLocaleDateString('vi-VN');
      // Photo is served through the auth-protected API proxy (same cookie)
      const photoUrl = `/api/wpsm/customer/photos/${p.photoId}`;
      photoArea.innerHTML = `
        <div class="group rounded-lg overflow-hidden border border-outline-variant/30 bg-surface-container-low flex flex-col hover:shadow-md transition-shadow max-w-sm">
          <div class="relative h-48 overflow-hidden">
            <img src="${photoUrl}" alt="Ảnh chuẩn bị hôn lễ"
              class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-300"
              onerror="this.parentElement.innerHTML='<div class=\'flex items-center justify-center h-full\'><span class=\'material-symbols-outlined text-[48px] text-on-surface-variant\'>image_not_supported</span></div>'"
            />
            <span class="absolute top-2 right-2 px-2 py-0.5 rounded text-[10px] font-bold uppercase bg-black/60 text-white backdrop-blur-sm">Mới nhất</span>
          </div>
          <div class="p-3">
            <p class="text-[11px] text-on-surface-variant flex items-center gap-1">
              <span class="material-symbols-outlined text-[13px]">person</span>
              Tải lên bởi: ${p.uploaderName}
            </p>
            <p class="text-[11px] text-on-surface-variant mt-0.5">${uploadedAt}</p>
          </div>
          <div class="px-3 pb-3">
            <a href="/C11" class="text-label-sm font-label-sm text-primary hover:underline inline-flex items-center gap-1">
              <span class="material-symbols-outlined text-[14px]">photo_library</span>Xem tất cả ảnh
            </a>
          </div>
        </div>`;

    } else {
      photoArea.innerHTML = `
        <div class="mt-2 p-5 rounded-xl bg-surface-container-low border border-outline-variant/30 flex flex-col md:flex-row items-start md:items-center justify-between gap-4">
          <div class="flex items-start gap-3">
            <div class="p-2.5 rounded-lg bg-primary/10 text-primary shrink-0">
              <span class="material-symbols-outlined text-[24px]">hourglass_empty</span>
            </div>
            <div>
              <h4 class="text-title-sm font-title-sm font-bold text-on-surface">Luồng ảnh trực tiếp</h4>
              <p class="text-body-sm font-body-sm text-on-surface-variant mt-0.5">
                Ảnh chuẩn bị sẽ xuất hiện tại đây khi Ban điều phối tải lên hình ảnh thực tế.
              </p>
            </div>
          </div>
          <a href="/C11" class="shrink-0 px-3 py-1.5 rounded-lg border border-primary text-primary text-label-md font-label-md hover:bg-primary/5 transition-colors">
            Xem tất cả ảnh
          </a>
        </div>`;
    }

    // Show content
    hide('state-loading');
    show('state-content');
  }

  // ── Fetch ──────────────────────────────────────────────────────────────────
  async function loadDashboard() {
    hide('state-error');
    show('state-loading');
    hide('state-content');

    try {
      // First try convenience endpoint (auto-selects first project for this customer)
      const res = await fetch('/api/wpsm/customer/dashboard', {
        credentials: 'same-origin'
      });

      if (res.status === 404) {
        // Customer has no project yet
        hide('state-loading');
        document.getElementById('state-error').querySelector('#err-msg').textContent =
          'Chưa có dự án hôn lễ nào được gắn với tài khoản của bạn.';
        show('state-error');
        return;
      }

      if (!res.ok) throw new Error(`HTTP ${res.status}`);

      const data = await res.json();
      render(data);
    } catch (err) {
      hide('state-loading');
      const errEl = document.getElementById('err-msg');
      if (errEl) errEl.textContent = err.message || 'Lỗi kết nối máy chủ.';
      show('state-error');
      console.error('[C01]', err);
    }
  }

  // Boot
  loadDashboard();
})();
</script>
