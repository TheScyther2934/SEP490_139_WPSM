      <div class="pt-3 mt-3 border-t border-outline-variant/20">
        <a href="/C05" class="w-full py-2 px-3 rounded-lg border border-primary text-primary hover:bg-primary/5 transition-colors font-title-sm text-title-sm flex items-center justify-center gap-1.5 active:scale-[0.98]">
          <span class="material-symbols-outlined text-[18px]">open_in_new</span>
          <span>Xem danh sách yêu cầu thay đổi</span>
        </a>
      </div>
    </div>

    <!-- Card 3: Outstanding Balance -->
    <div class="rounded-xl bg-surface-container-lowest border border-outline-variant/30 p-5 shadow-sm flex flex-col justify-between">
      <div>
        <div class="flex items-center justify-between pb-3 border-b border-outline-variant/20 mb-3">
          <h3 class="text-title-md font-title-md font-semibold text-on-surface">Thanh toán</h3>
          <a href="/C10" class="text-label-md font-label-md text-primary font-semibold hover:underline">Xem chi tiết →</a>
        </div>
        <div>
          <span class="text-label-md font-label-md text-on-surface-variant">Dư nợ còn lại</span>
          <p class="font-headline-md text-headline-md font-serif text-primary font-bold" id="balance-outstanding">—</p>
        </div>
        <!-- Progress bar -->
        <div class="mt-3">
          <div class="flex justify-between text-body-sm font-body-sm mb-1.5">
            <span class="text-[11px] font-medium text-emerald-800">Đã thanh toán: <span id="balance-paid">—</span></span>
            <span class="text-[11px] text-on-surface-variant font-medium">Tổng: <span id="balance-total">—</span></span>
          </div>
          <div class="h-2.5 w-full bg-surface-container-high rounded-full overflow-hidden">
            <div class="h-full bg-primary rounded-full transition-all duration-700" id="balance-bar" style="width:0%"></div>
