    <div class="absolute right-1/3 -top-12 w-64 h-64 rounded-full bg-primary-fixed-dim/10 blur-2xl pointer-events-none"></div>
    <div class="relative z-10 grid grid-cols-1 lg:grid-cols-12 gap-8 items-center">
      <!-- Left: couple info -->
      <div class="lg:col-span-7 space-y-4">
        <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-white/10 backdrop-blur-md border border-white/20 text-on-primary text-label-sm font-label-sm uppercase tracking-wider">
          <span class="material-symbols-outlined text-[14px] text-secondary-fixed">auto_awesome</span>
          <span>LỄ THÀNH HÔN CHÍNH THỨC</span>
        </div>
        <div>
          <h1 class="text-display-lg font-display-lg text-white font-serif tracking-tight drop-shadow-sm" id="banner-couple">—</h1>
          <div class="flex flex-wrap items-center gap-3 mt-2 text-white/90 text-body-md font-body-md">
            <span class="inline-flex items-center gap-1.5">
              <span class="material-symbols-outlined text-[18px] text-secondary-fixed">meeting_room</span>
              <span id="banner-hall">—</span>
            </span>
            <span class="text-white/40">•</span>
            <span class="inline-flex items-center gap-1.5">
              <span class="material-symbols-outlined text-[18px] text-secondary-fixed">schedule</span>
              <span id="banner-slot">—</span>
            </span>
            <span class="text-white/40">•</span>
            <span class="inline-flex items-center gap-1.5">
              <span class="material-symbols-outlined text-[18px] text-secondary-fixed">calendar_month</span>
              <span id="banner-date">—</span>
            </span>
          </div>
        </div>
        <div class="flex flex-wrap items-center gap-3 pt-2">
          <a href="/C02" class="inline-flex items-center gap-2 px-4 py-2.5 rounded-lg bg-surface-container-lowest text-primary font-title-sm text-title-sm shadow-sm hover:bg-surface-container transition-all active:scale-[0.98]">
            <span class="material-symbols-outlined text-[18px]">verified</span>
            <span>Xem hợp đồng đã chốt</span>
