        <ul id="task-list" class="space-y-3"></ul>
        <!-- Empty state -->
        <div id="task-empty" class="hidden py-8 flex flex-col items-center gap-2 text-on-surface-variant text-center">
          <span class="material-symbols-outlined text-[36px]">task_alt</span>
          <p class="text-body-sm font-body-sm">Không còn nhiệm vụ nào cần theo dõi.</p>
        </div>
      </div>
      <div class="pt-3 mt-3 border-t border-outline-variant/20 flex items-center gap-1.5 text-body-sm font-body-sm text-on-surface-variant">
        <span class="material-symbols-outlined text-[16px] text-primary">sync</span>
        <span>Nhắc nhở tự động được đồng bộ với điều phối viên.</span>
      </div>
    </div>

    <!-- Card 2: Change Requests -->
    <div class="rounded-xl bg-surface-container-lowest border border-outline-variant/30 p-5 shadow-sm flex flex-col justify-between">
      <div>
        <div class="flex items-center justify-between pb-3 border-b border-outline-variant/20 mb-3">
          <h3 class="text-title-md font-title-md font-semibold text-on-surface">Yêu cầu thay đổi (CR)</h3>
          <a href="/C05" class="text-label-md font-label-md text-primary font-semibold hover:underline">Xem tất cả →</a>
