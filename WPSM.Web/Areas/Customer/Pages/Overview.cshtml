          </div>
          <div class="mt-2 h-2 w-full bg-surface-container-high rounded-full overflow-hidden">
            <div class="h-full bg-secondary rounded-full transition-all duration-700" id="roadmap-bar" style="width:0%"></div>
          </div>
        </div>
      </div>
      <div class="pt-3 mt-3 border-t border-outline-variant/20 flex items-center justify-between">
        <span class="inline-flex items-center gap-1 text-label-sm font-label-sm text-emerald-700 bg-emerald-50 px-2.5 py-1 rounded-full border border-emerald-200 font-semibold" id="nrd-badge">
          <span class="material-symbols-outlined text-[14px]">verified</span>
