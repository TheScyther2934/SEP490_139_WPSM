            <h3 class="text-title-md font-title-md font-semibold text-on-surface">Nhiệm vụ sắp tới</h3>
            <span id="task-badge" class="px-2 py-0.5 rounded-full text-label-sm font-label-sm font-bold bg-amber-100 text-amber-900 border border-amber-200 hidden"></span>
          </div>
          <a href="/C03" class="text-label-md font-label-md text-primary font-semibold hover:underline inline-flex items-center">Xem lộ trình →</a>
        </div>
