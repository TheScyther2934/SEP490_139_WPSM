@page "/C01"
@{ ViewData["Title"] = "WPSM Portal — Tổng quan Hôn lễ (C-01)"; }
<div data-wpsm-screen="C01">

<!-- ========================================================================= -->
<!-- SHARED COMPONENT 1: SideNavBar (Fixed Left Rail)                           -->
<!-- ========================================================================= -->
@await Html.PartialAsync("/Areas/Customer/Pages/Shared/_CustomerNavigation.cshtml")

<!-- ========================================================================= -->
<!-- MAIN WORKSPACE & TOP BAR                                                  -->
<!-- ========================================================================= -->
<div class="ml-64 flex-1 flex flex-col">

<!-- TOP BAR -->
<header class="sticky top-0 z-20 flex justify-between items-center w-full px-8 py-3.5 bg-surface-container-lowest border-b border-outline-variant/30 shadow-sm backdrop-blur-md">
  <div class="flex items-center gap-4">
    <div class="flex items-center gap-2 text-body-sm font-body-sm text-on-surface-variant">
      <span class="hover:text-primary cursor-pointer transition-colors">Trang chủ</span>
      <span class="text-outline-variant">/</span>
      <span class="font-semibold text-primary">Tổng quan</span>
    </div>
    <div class="h-4 w-[1px] bg-outline-variant/40"></div>
    <div class="flex items-center gap-2">
      <span class="px-2 py-0.5 rounded-full text-label-sm font-label-sm uppercase font-semibold bg-primary/10 text-primary border border-primary/20">MÃ: C-01</span>
      <span class="text-label-md font-label-md text-on-surface-variant hidden lg:inline">Cổng thông tin Khách hàng</span>
    </div>
  </div>
  <!-- Event chips -->
  <div class="hidden xl:flex items-center gap-2" id="hdr-chips">
    <div class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-full text-label-sm font-label-sm bg-surface-container text-on-surface border border-outline-variant/30">
      <span class="material-symbols-outlined text-[14px] text-primary">tag</span>
      <span id="hdr-code">—</span>
    </div>
    <div class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-full text-label-sm font-label-sm bg-secondary-fixed/30 text-secondary border border-secondary/30">
      <span class="material-symbols-outlined text-[14px]">meeting_room</span>
      <span id="hdr-hall">—</span>
    </div>
    <div class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-full text-label-sm font-label-sm bg-surface-container text-on-surface border border-outline-variant/30">
      <span class="material-symbols-outlined text-[14px]">calendar_today</span>
      <span id="hdr-date">—</span>
    </div>
  </div>
  <!-- Right actions -->
  <div class="flex items-center gap-4">
    <div class="h-6 w-[1px] bg-outline-variant/40"></div>
    <div class="flex items-center gap-2.5 pl-1">
      <div class="flex flex-col text-left">
        <span class="text-title-sm font-title-sm text-on-surface font-semibold leading-tight" id="hdr-name">…</span>
        <span class="text-[10px] font-label-sm uppercase tracking-wider text-primary font-bold">KHÁCH HÀNG</span>
      </div>
    </div>
  </div>
</header>

<!-- ========================================================================= -->
<!-- LOADING STATE                                                              -->
<!-- ========================================================================= -->
<div id="state-loading" class="flex-1 flex items-center justify-center py-24">
  <div class="flex flex-col items-center gap-4 text-on-surface-variant">
    <span class="material-symbols-outlined text-[48px] animate-spin text-primary">progress_activity</span>
    <p class="text-body-md font-body-md">Đang tải dữ liệu hôn lễ…</p>
  </div>
</div>

<!-- ========================================================================= -->
<!-- ERROR STATE                                                                -->
<!-- ========================================================================= -->
<div id="state-error" class="hidden flex-1 flex items-center justify-center py-24">
  <div class="flex flex-col items-center gap-4 text-center max-w-md">
    <span class="material-symbols-outlined text-[48px] text-error">cloud_off</span>
    <p class="text-title-md font-title-md text-on-surface">Không thể tải dữ liệu</p>
    <p class="text-body-sm font-body-sm text-on-surface-variant" id="err-msg">Kiểm tra kết nối và thử lại.</p>
    <button onclick="loadDashboard()" class="px-4 py-2 rounded-lg bg-primary text-on-primary font-title-sm text-title-sm hover:bg-primary/90 transition-colors">Thử lại</button>
  </div>
</div>

<!-- ========================================================================= -->
<!-- MAIN CONTENT CANVAS (hidden until data loaded)                            -->
<!-- ========================================================================= -->
<main id="state-content" class="hidden flex-1 px-8 py-6 space-y-6 max-w-7xl w-full mx-auto">

  <!-- 1. HERO COUNTDOWN BANNER -->
