    <div class="flex items-center gap-3">
      <span class="text-title-sm font-title-sm text-primary font-semibold">WPSM Portal</span>
      <span class="text-outline-variant">•</span>
      <span>© 2025 WPSM Hospitality Group.</span>
    </div>
    <a class="text-primary font-medium hover:underline flex items-center gap-1" href="tel:19008888">
      <span class="material-symbols-outlined text-[16px]">call</span>
