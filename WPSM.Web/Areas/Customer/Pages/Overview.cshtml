            <span class="text-label-sm font-label-sm uppercase tracking-wider text-secondary-fixed font-bold">ĐẾM NGƯỢC NGÀY TRỌNG ĐẠI</span>
            <span class="inline-flex items-center gap-1 text-[11px] text-white/70">
              <span class="w-2 h-2 rounded-full bg-emerald-400 animate-pulse"></span>
              Thời gian thực
            </span>
          </div>
          <div class="py-4 my-1">
            <div class="flex items-baseline gap-2">
              <span class="font-display-lg text-display-lg font-serif text-white tracking-tight leading-none drop-shadow" id="countdown-label">—</span>
            </div>
