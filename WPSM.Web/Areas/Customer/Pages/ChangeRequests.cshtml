@page "/C05"
@{ ViewData["Title"] = "WPSM Portal — Yêu cầu thay đổi (C-05)"; }
<div data-wpsm-screen="C05">

@await Html.PartialAsync("/Areas/Customer/Pages/Shared/_CustomerNavigation.cshtml")

<div class="ml-64 flex-1 flex flex-col">
<header class="sticky top-0 z-20 flex justify-between items-center w-full px-8 py-3.5 bg-surface-container-lowest border-b border-outline-variant/30 shadow-sm">
  <div class="flex items-center gap-4">
    <nav class="flex items-center gap-2 text-body-sm font-body-sm text-on-surface-variant">
      <a href="/C01" class="hover:text-primary transition-colors">Tổng quan</a>
      <span class="text-outline-variant">/</span>
      <span class="font-semibold text-primary">Yêu cầu thay đổi</span>
    </nav>
    <span class="px-2 py-0.5 rounded-full text-label-sm font-label-sm uppercase font-semibold bg-primary/10 text-primary border border-primary/20">MÃ: C-05</span>
  </div>
</header>

<main class="flex-1 px-8 py-6 max-w-7xl w-full mx-auto">
  <!-- Under construction notice -->
  <div class="flex flex-col items-center justify-center py-24 gap-6 text-center">
    <div class="p-5 rounded-2xl bg-amber-50 border border-amber-200">
      <span class="material-symbols-outlined text-[64px] text-amber-500">change_circle</span>
    </div>
    <h1 class="text-headline-md font-headline-md text-on-surface">Yêu cầu thay đổi (CR)</h1>
    <p class="text-body-lg font-body-lg text-on-surface-variant max-w-md">
      Màn hình C-05 đang được triển khai. Bạn có thể xem tóm tắt số CR đang mở tại
      <a href="/C01" class="text-primary font-semibold hover:underline">Dashboard tổng quan</a>.
    </p>
    <a href="/C01" class="inline-flex items-center gap-2 px-5 py-2.5 rounded-lg bg-primary text-on-primary font-title-sm text-title-sm hover:bg-primary/90 transition-colors">
      <span class="material-symbols-outlined text-[18px]">arrow_back</span>
      Quay lại Tổng quan
    </a>
  </div>
</main>

<footer class="w-full py-4 border-t border-outline-variant/30 bg-surface-container-lowest mt-auto">
  <div class="flex items-center justify-between px-8 py-2 text-body-sm font-body-sm text-on-surface-variant">
    <span class="text-title-sm font-title-sm text-primary font-semibold">WPSM Portal</span>
    <a href="tel:19008888" class="text-primary font-medium hover:underline flex items-center gap-1">
      <span class="material-symbols-outlined text-[16px]">call</span>1900 8888
    </a>
  </div>
</footer>
</div>
</div>
