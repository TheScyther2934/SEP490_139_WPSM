@page "/A14"
@{ ViewData["Title"] = "WPSM Executive - Chi tiết ảnh (A-14)"; ViewData["AdminCrumb"] = "Chi tiết ảnh (A-14)"; }
<div data-wpsm-screen="A14">
<div class="flex flex-1 w-full relative">
@await Html.PartialAsync("/Areas/Admin/Pages/Shared/_AdminNavigation.cshtml")
<div class="flex-1 ml-64 flex flex-col min-w-0">
@await Html.PartialAsync("/Areas/Admin/Pages/Shared/_AdminHeader.cshtml")
<main class="flex-1 p-8 max-w-[1440px] w-full mx-auto space-y-6">
<h1 class="font-headline-md text-headline-md font-bold text-primary tracking-tight">Chi tiết ảnh minh chứng</h1>
<div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
<div class="lg:col-span-2 rounded-xl border border-outline-variant/30 bg-surface-container-low min-h-[360px] flex items-center justify-center overflow-hidden">
<img id="a14Image" class="hidden max-h-[640px] w-full object-contain" alt="Ảnh minh chứng" />
<span id="a14Empty" class="text-sm text-on-surface-variant">Đang tải ảnh…</span>
</div>
<dl class="rounded-xl border border-outline-variant/30 bg-surface-container-lowest p-5 space-y-4 text-sm">
<div><dt class="text-on-surface-variant">Dự án</dt><dd class="font-semibold" data-field="project">—</dd></div>
<div><dt class="text-on-surface-variant">Sảnh / Ca</dt><dd class="font-semibold" data-field="hallSlot">—</dd></div>
<div><dt class="text-on-surface-variant">Nhiệm vụ</dt><dd class="font-semibold" data-field="task">—</dd></div>
<div><dt class="text-on-surface-variant">Hạn chót</dt><dd class="font-semibold" data-field="deadline">—</dd></div>
<div><dt class="text-on-surface-variant">Thời gian tải lên</dt><dd class="font-semibold" data-field="uploadedAt">—</dd></div>
<div><dt class="text-on-surface-variant">Người tải lên</dt><dd class="font-semibold" data-field="uploader">—</dd></div>
</dl>
</div>
<a href="/A13" class="text-sm text-secondary hover:underline">← Quay lại danh sách ảnh</a>
</main>
</div>
</div>
</div>
