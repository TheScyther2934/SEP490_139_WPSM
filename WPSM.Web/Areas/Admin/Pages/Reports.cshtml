@page "/A09"
@{ ViewData["Title"] = "WPSM Executive - Báo cáo (A-09)"; ViewData["AdminCrumb"] = "Báo cáo (A-09)"; }
<div data-wpsm-screen="A09">
<div class="flex flex-1 w-full relative">
@await Html.PartialAsync("/Areas/Admin/Pages/Shared/_AdminNavigation.cshtml")
<div class="flex-1 ml-64 flex flex-col min-w-0">
@await Html.PartialAsync("/Areas/Admin/Pages/Shared/_AdminHeader.cshtml")
<main class="flex-1 p-8 max-w-[1440px] w-full mx-auto space-y-6">
<h1 class="font-headline-md text-headline-md font-bold text-primary tracking-tight">Báo cáo</h1>
<nav class="flex flex-wrap gap-2">
<a class="report-tab px-4 py-2 rounded-lg border border-outline-variant bg-surface-container-lowest hover:border-primary" href="/A10">Công suất sảnh</a>
<a class="report-tab px-4 py-2 rounded-lg border border-outline-variant bg-surface-container-lowest hover:border-primary" href="/A11">Doanh thu thuần</a>
<a class="report-tab px-4 py-2 rounded-lg border border-outline-variant bg-surface-container-lowest hover:border-primary" href="/A12">Thống kê CR</a>
</nav>
@await Html.PartialAsync("/Areas/Admin/Pages/Shared/_ReportFilter.cshtml")
<div class="grid grid-cols-1 md:grid-cols-3 gap-4">
<div class="bg-surface-container-lowest p-5 rounded-xl border border-outline-variant/30 shadow-sm">
<div class="font-label-md text-label-md text-on-surface-variant">Công suất sảnh</div>
<div class="font-headline-sm text-headline-sm font-bold text-primary" data-field="utilization">—</div></div>
<div class="bg-surface-container-lowest p-5 rounded-xl border border-outline-variant/30 shadow-sm">
<div class="font-label-md text-label-md text-on-surface-variant">Doanh thu thuần (đã thu)</div>
<div class="font-headline-sm text-headline-sm font-bold text-primary" data-field="netRevenue">—</div></div>
<div class="bg-surface-container-lowest p-5 rounded-xl border border-outline-variant/30 shadow-sm">
<div class="font-label-md text-label-md text-on-surface-variant">CR đã duyệt</div>
<div class="font-headline-sm text-headline-sm font-bold text-primary" data-field="crsApproved">—</div></div>
</div>
<p class="text-xs text-on-surface-variant">Mỗi tab mở báo cáo riêng: A-10 Công suất sảnh, A-11 Doanh thu thuần, A-12 Thống kê CR. Khoảng ngày được giữ khi chuyển tab.</p>
</main>
</div>
</div>
</div>
