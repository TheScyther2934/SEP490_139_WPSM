@page "/A13"
@{ ViewData["Title"] = "WPSM Executive - Ảnh minh chứng trực tiếp (A-13)"; ViewData["AdminCrumb"] = "Ảnh minh chứng trực tiếp (A-13)"; }
<div data-wpsm-screen="A13">
<div class="flex flex-1 w-full relative">
@await Html.PartialAsync("/Areas/Admin/Pages/Shared/_AdminNavigation.cshtml")
<div class="flex-1 ml-64 flex flex-col min-w-0">
@await Html.PartialAsync("/Areas/Admin/Pages/Shared/_AdminHeader.cshtml")
<main class="flex-1 p-8 max-w-[1440px] w-full mx-auto space-y-6">
<div>
<h1 class="font-headline-md text-headline-md font-bold text-primary tracking-tight">Ảnh minh chứng trực tiếp</h1>
<p class="text-sm text-on-surface-variant">Tự làm mới mỗi 30 giây · ảnh theo ngày đã chọn</p>
</div>
<div class="flex flex-wrap items-end gap-3">
<label class="text-sm text-on-surface-variant">Ngày<input id="feedDate" type="date" class="mt-1 block rounded-lg border-outline-variant bg-surface-container-lowest text-sm" /></label>
<label class="text-sm text-on-surface-variant">Dự án<select id="feedProject" class="mt-1 block rounded-lg border-outline-variant bg-surface-container-lowest text-sm"><option value="">Tất cả dự án</option></select></label>
<label class="text-sm text-on-surface-variant">Sảnh<select id="feedHall" class="mt-1 block rounded-lg border-outline-variant bg-surface-container-lowest text-sm"><option value="">Tất cả sảnh</option></select></label>
<label class="text-sm text-on-surface-variant">Trạng thái nhiệm vụ<select id="feedStatus" class="mt-1 block rounded-lg border-outline-variant bg-surface-container-lowest text-sm">
<option value="">Tất cả trạng thái</option><option value="Pending">Chờ thực hiện</option><option value="Done">Hoàn thành</option><option value="Overdue">Quá hạn</option></select></label>
</div>
<div id="a13Photos" class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4"></div>
</main>
</div>
</div>
</div>
