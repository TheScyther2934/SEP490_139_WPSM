@page "/A11"
@{ ViewData["Title"] = "WPSM Executive - Doanh thu thuần (A-11)"; ViewData["AdminCrumb"] = "Doanh thu thuần (A-11)"; }
<div data-wpsm-screen="A11">
<div class="flex flex-1 w-full relative">
@await Html.PartialAsync("/Areas/Admin/Pages/Shared/_AdminNavigation.cshtml")
<div class="flex-1 ml-64 flex flex-col min-w-0">
@await Html.PartialAsync("/Areas/Admin/Pages/Shared/_AdminHeader.cshtml")
<main class="flex-1 p-8 max-w-[1440px] w-full mx-auto space-y-6">
<div class="flex items-center gap-3"><a href="/A09" class="text-sm text-secondary hover:underline">← Báo cáo</a><h1 class="font-headline-md text-headline-md font-bold text-primary tracking-tight">Doanh thu thuần</h1></div>
@await Html.PartialAsync("/Areas/Admin/Pages/Shared/_ReportFilter.cshtml")
<div class="grid grid-cols-1 lg:grid-cols-2 gap-6">
<section class="rounded-xl border border-outline-variant/30 bg-surface-container-lowest p-5">
<h2 class="font-title-sm text-title-sm font-semibold text-on-surface mb-3">Tiền đã thu theo tháng (VND)</h2>
<div id="reportChart"></div>
</section>
<table class="w-full text-sm bg-surface-container-lowest rounded-xl border border-outline-variant/30 overflow-hidden">
<thead class="bg-surface-container-low text-on-surface-variant"><tr><th class="py-3 px-4 text-left">Tháng</th><th class="py-3 px-4 text-right">Giá trị gốc</th><th class="py-3 px-4 text-right">Chênh lệch CR</th><th class="py-3 px-4 text-right">Đã thu</th><th class="py-3 px-4 text-right">Còn phải thu</th></tr></thead>
<tbody id="reportTable"></tbody>
</table>
</div>
<p class="text-xs text-on-surface-variant">Giá trị gốc, chênh lệch CR và còn phải thu tính theo các tiệc diễn ra trong tháng; đã thu tính theo ngày thanh toán.</p>
</main>
</div>
</div>
</div>
