@page "/A01"
@{ ViewData["Title"] = "WPSM Executive - Tổng quan điều hành (A-01)"; ViewData["AdminCrumb"] = "Tổng quan điều hành (A-01)"; }
<div data-wpsm-screen="A01">
<div class="flex flex-1 w-full relative">
@await Html.PartialAsync("/Areas/Admin/Pages/Shared/_AdminNavigation.cshtml")
<div class="flex-1 ml-64 flex flex-col min-w-0">
@await Html.PartialAsync("/Areas/Admin/Pages/Shared/_AdminHeader.cshtml")
<main class="flex-1 p-8 max-w-[1440px] w-full mx-auto space-y-6">
<h1 class="font-headline-md text-headline-md font-bold text-primary tracking-tight">Tổng quan điều hành</h1>
<div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4">
<a href="/A09" class="block bg-surface-container-lowest p-5 rounded-xl border border-outline-variant/30 shadow-sm hover:border-primary/40">
<div class="font-label-md text-label-md text-on-surface-variant">Sự kiện sắp tới (30 ngày)</div>
<div class="font-headline-sm text-headline-sm font-bold text-primary" data-field="upcomingEvents">—</div></a>
<a href="/A10" class="block bg-surface-container-lowest p-5 rounded-xl border border-outline-variant/30 shadow-sm hover:border-primary/40">
<div class="font-label-md text-label-md text-on-surface-variant">Công suất sảnh tháng này</div>
<div class="font-headline-sm text-headline-sm font-bold text-primary" data-field="hallUtilization">—</div></a>
<a href="/A11" class="block bg-surface-container-lowest p-5 rounded-xl border border-outline-variant/30 shadow-sm hover:border-primary/40">
<div class="font-label-md text-label-md text-on-surface-variant">Doanh thu thuần tháng này</div>
<div class="font-headline-sm text-headline-sm font-bold text-primary" data-field="netRevenue">—</div></a>
<a href="/A12" class="block bg-surface-container-lowest p-5 rounded-xl border border-outline-variant/30 shadow-sm hover:border-primary/40">
<div class="font-label-md text-label-md text-on-surface-variant">CR đang thương lượng</div>
<div class="font-headline-sm text-headline-sm font-bold text-primary" data-field="activeCrs">—</div></a>
<a href="/A15" class="block bg-surface-container-lowest p-5 rounded-xl border border-outline-variant/30 shadow-sm hover:border-primary/40">
<div class="font-label-md text-label-md text-on-surface-variant">Nhiệm vụ quá hạn</div>
<div class="font-headline-sm text-headline-sm font-bold text-error" data-field="overdueTasks">—</div></a>
<a href="/A16" class="block bg-surface-container-lowest p-5 rounded-xl border border-outline-variant/30 shadow-sm hover:border-primary/40">
<div class="font-label-md text-label-md text-on-surface-variant">Khiếu nại chuyển cấp</div>
<div class="font-headline-sm text-headline-sm font-bold text-error" data-field="escalatedComplaints">—</div></a>
</div>
<section class="rounded-xl border border-error/30 bg-error-container/20 p-5 space-y-2">
<h2 class="font-title-md text-title-md font-bold text-on-surface">Cảnh báo quá hạn (trực tiếp)</h2>
<div id="a01Alerts" class="space-y-2"></div>
</section>
<section class="rounded-xl border border-outline-variant/30 bg-surface-container-lowest p-5 space-y-3">
<h2 class="font-title-md text-title-md font-bold text-on-surface">Ảnh minh chứng mới nhất</h2>
<div id="a01Photos" class="grid grid-cols-2 md:grid-cols-5 gap-3"></div>
</section>
</main>
</div>
</div>
</div>
