@page "/A16"
@{ ViewData["Title"] = "WPSM Executive - Khiếu nại chuyển cấp (A-16)"; ViewData["AdminCrumb"] = "Khiếu nại chuyển cấp (A-16)"; }
<div data-wpsm-screen="A16">
<div class="flex flex-1 w-full relative">
@await Html.PartialAsync("/Areas/Admin/Pages/Shared/_AdminNavigation.cshtml")
<div class="flex-1 ml-64 flex flex-col min-w-0">
@await Html.PartialAsync("/Areas/Admin/Pages/Shared/_AdminHeader.cshtml")
<main class="flex-1 p-8 max-w-[1440px] w-full mx-auto space-y-6">
<h1 class="font-headline-md text-headline-md font-bold text-primary tracking-tight">Khiếu nại chuyển cấp</h1>
<table class="w-full text-sm bg-surface-container-lowest rounded-xl border border-outline-variant/30 overflow-hidden">
<thead class="bg-surface-container-low text-on-surface-variant"><tr><th class="py-3 px-4 text-left">Mã</th><th class="py-3 px-4 text-left">Dự án</th><th class="py-3 px-4 text-left">Mô tả</th><th class="py-3 px-4 text-left">Ngày chuyển cấp</th><th class="py-3 px-4 text-left">Thao tác</th></tr></thead>
<tbody id="a16Table"></tbody>
</table>
<section id="a16Detail" class="hidden rounded-xl border border-outline-variant/30 bg-surface-container-lowest p-6 space-y-4">
<h2 class="font-title-md text-title-md font-bold text-on-surface"><span data-field="code"></span> · chi tiết</h2>
<dl class="grid grid-cols-[160px_1fr] gap-x-4 gap-y-3 text-sm">
<dt class="text-on-surface-variant">Khiếu nại</dt><dd data-field="description"></dd>
<dt class="text-on-surface-variant">Ghi chú của Manager</dt><dd data-field="managerNote"></dd>
<dt class="text-on-surface-variant">BEO / ảnh</dt><dd><a class="text-secondary hover:underline" data-field="evidence" href="/A13"></a></dd>
</dl>
<div class="flex flex-wrap items-end gap-4">
<label class="flex-1 min-w-[280px] text-sm text-on-surface-variant">Quyết định (bắt buộc, tối đa 1000 ký tự)*
<textarea id="a16Decision" maxlength="1000" rows="4" class="mt-1 block w-full rounded-lg border-outline-variant bg-surface-container-lowest text-sm"></textarea></label>
<button type="button" data-action="open-resolve" class="px-6 py-2.5 rounded-lg bg-emerald-700 text-white font-semibold hover:bg-emerald-800">Giải quyết</button>
</div>
<p id="a16Error" class="hidden text-sm text-error"></p>
</section>
</main>
</div>
</div>
<div id="modal-a17" class="hidden fixed inset-0 z-[60] flex items-center justify-center bg-black/40 p-4" role="dialog" aria-modal="true" aria-labelledby="a17Title">
<div class="w-full max-w-xl rounded-xl bg-surface-container-lowest shadow-xl">
<div class="flex items-center justify-between border-b border-outline-variant/40 px-6 py-4">
<h2 id="a17Title" class="font-title-md text-title-md font-bold">Giải quyết khiếu nại – <span data-field="code"></span></h2>
<button type="button" data-action="close-resolve" class="text-on-surface-variant" aria-label="Đóng">✕</button>
</div>
<div class="px-6 py-5 space-y-2">
<label class="text-sm text-on-surface-variant">Quyết định (bắt buộc, tối đa 1000 ký tự)*
<textarea id="a17Decision" maxlength="1000" rows="5" class="mt-1 block w-full rounded-lg border-outline-variant bg-surface-container-lowest text-sm"></textarea></label>
<p class="text-xs text-on-surface-variant">Khiếu nại sẽ được đóng và hệ thống thông báo cho Manager và Khách hàng.</p>
<p id="a17Error" class="hidden text-sm text-error"></p>
</div>
<div class="flex justify-end gap-3 border-t border-outline-variant/40 px-6 py-4">
<button type="button" data-action="close-resolve" class="px-5 py-2 rounded-lg border border-outline-variant">Hủy</button>
<button type="button" data-action="confirm-resolve" class="px-5 py-2 rounded-lg bg-emerald-700 text-white font-semibold hover:bg-emerald-800">Giải quyết</button>
</div>
</div>
</div>
</div>
