<div class="flex flex-wrap items-end gap-3">
<label class="text-sm text-on-surface-variant">Từ ngày
<input id="reportFrom" type="date" required class="mt-1 block rounded-lg border-outline-variant bg-surface-container-lowest text-sm" /></label>
<label class="text-sm text-on-surface-variant">Đến ngày
<input id="reportTo" type="date" required class="mt-1 block rounded-lg border-outline-variant bg-surface-container-lowest text-sm" /></label>
<button type="button" data-action="apply-report" class="px-4 py-2 rounded-lg bg-primary text-on-primary font-semibold hover:bg-primary-container">Áp dụng</button>
<span id="reportError" class="hidden text-sm text-error"></span>
</div>
