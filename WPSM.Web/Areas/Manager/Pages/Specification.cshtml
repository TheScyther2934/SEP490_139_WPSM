@page "/M05"
@{ ViewData["Title"] = "WPSM - Đặc tả & Chốt hợp đồng gốc (M-05)"; }
<div data-wpsm-screen="M05">
    @await Html.PartialAsync("/Areas/Manager/Pages/Shared/_ManagerNavigation.cshtml")

    <header class="ml-64 sticky top-0 z-20 flex flex-wrap items-center justify-between gap-4 border-b border-outline-variant/30 bg-surface-container-lowest px-6 py-3 shadow-sm">
        <div>
            <p class="text-label-md text-on-surface-variant">Dự án <span class="mx-1 text-outline-variant">/</span> Đặc tả &amp; Chốt hợp đồng gốc (M-05)</p>
            <div class="mt-1 flex flex-wrap items-center gap-2">
                <span class="rounded-md border border-outline-variant/40 bg-surface-container-low px-2.5 py-1 font-label-md text-label-md text-on-surface">Mã: <strong data-m05="project-code">Chưa chọn</strong></span>
                <span class="rounded-md border border-secondary/30 bg-secondary-fixed/30 px-2.5 py-1 font-label-md text-label-md font-semibold text-secondary" data-m05="hall">Chọn dự án để bắt đầu</span>
                <span data-m05="baseline-status" class="rounded-full border border-amber-300 bg-amber-50 px-3 py-1 text-label-md font-semibold text-amber-800">Chưa chọn dự án</span>
            </div>
        </div>
        <label class="flex items-center gap-2 text-label-md font-medium text-on-surface-variant" for="m05ProjectSelect">
            Dự án
            <select id="m05ProjectSelect" class="min-w-64 rounded-lg border border-outline-variant bg-white px-3 py-2 text-sm text-on-surface focus:border-primary focus:ring-primary">
                <option value="">Đang tải danh sách…</option>
            </select>
        </label>
    </header>

    <main class="ml-64 max-w-[1440px] space-y-6 p-6 md:p-8">
        <section class="flex flex-col justify-between gap-4 md:flex-row md:items-end">
            <div class="space-y-2">
                <span class="inline-flex rounded bg-primary-container px-2 py-0.5 text-[11px] font-bold uppercase tracking-wider text-on-primary">Manager · FE-02</span>
                <h1 class="font-headline-lg text-headline-lg font-semibold tracking-tight text-primary">Đặc tả dịch vụ &amp; Baseline gốc</h1>
                <p class="max-w-3xl text-body-md text-on-surface-variant">Cập nhật hạng mục, số lượng và đơn giá theo Catalog. Kiểm tra đủ Core Combo và PriceFrame trước khi khóa phiên bản gốc.</p>
                <p class="text-body-sm text-on-surface-variant"><strong data-m05="couple-name" class="text-on-surface">—</strong> <span class="mx-1">•</span> Ngày tiệc: <span data-m05="event-date">—</span></p>
            </div>
            <div class="flex flex-wrap items-center gap-2">
                <button type="button" id="openCatalogBtn" class="inline-flex items-center gap-2 rounded-lg border border-secondary px-3.5 py-2 font-label-md text-label-md font-medium text-secondary transition hover:bg-secondary/10 disabled:cursor-not-allowed disabled:opacity-50" disabled>
                    <span class="material-symbols-outlined text-[18px]">add</span> Thêm từ Catalog
                </button>
                <button type="button" id="saveSpecificationBtn" class="inline-flex items-center gap-2 rounded-lg border border-outline-variant px-4 py-2 font-label-md text-label-md font-semibold text-on-surface transition hover:bg-surface-container-low disabled:cursor-not-allowed disabled:opacity-50" disabled>
                    <span class="material-symbols-outlined text-[18px]">save</span> Lưu nháp đặc tả
                </button>
                <button type="button" id="openFreezeBtn" class="inline-flex items-center gap-2 rounded-lg bg-primary px-4 py-2 font-label-md text-label-md font-semibold text-white shadow-sm transition hover:bg-[#5D1F31] disabled:cursor-not-allowed disabled:opacity-50" disabled>
                    <span class="material-symbols-outlined text-[18px]">lock</span> Chốt Baseline
                </button>
            </div>
        </section>

        <div id="m05Error" role="alert" class="hidden rounded-lg border border-red-200 bg-red-50 px-4 py-3 text-sm text-red-800"></div>
        <div id="m05Notice" role="status" aria-live="polite" class="hidden rounded-lg border border-emerald-200 bg-emerald-50 px-4 py-3 text-sm text-emerald-800"></div>
        <div id="freezeBanner" class="hidden items-center gap-3 rounded-xl border border-emerald-200 bg-emerald-50 px-4 py-3 text-emerald-900">
            <span class="material-symbols-outlined">verified</span>
            <div><strong>Baseline gốc đã được đóng băng.</strong><p class="text-sm" data-m05="frozen-at"></p></div>
        </div>

        <section class="grid grid-cols-1 gap-4 sm:grid-cols-3" aria-label="Tóm tắt đặc tả">
            <article class="rounded-xl border border-outline-variant/30 bg-white p-5 shadow-sm">
                <p class="text-label-md text-on-surface-variant">Giá trị hợp đồng gốc</p>
                <p class="mt-2 font-headline-sm text-headline-sm font-semibold text-primary" data-m05="base-value">—</p>
            </article>
            <article class="rounded-xl border border-outline-variant/30 bg-white p-5 shadow-sm">
                <p class="text-label-md text-on-surface-variant">Tổng đặc tả hiện tại</p>
                <p class="mt-2 font-headline-sm text-headline-sm font-semibold text-on-surface" data-m05="spec-total">—</p>
            </article>
            <article class="rounded-xl border border-outline-variant/30 bg-white p-5 shadow-sm">
                <p class="text-label-md text-on-surface-variant">Số hạng mục</p>
                <p class="mt-2 font-headline-sm text-headline-sm font-semibold text-on-surface" data-m05="item-count">—</p>
            </article>
        </section>

        <section class="overflow-hidden rounded-xl border border-outline-variant/30 bg-white shadow-sm">
            <header class="flex flex-col justify-between gap-2 border-b border-outline-variant/30 bg-surface-container-lowest p-5 sm:flex-row sm:items-center">
                <div>
                    <h2 class="font-headline-sm text-headline-sm text-primary">Danh sách hạng mục</h2>
                    <p class="mt-1 text-body-sm text-on-surface-variant">Mỗi dịch vụ chỉ được chọn một lần. Đơn giá phải nằm trong PriceFrame đang hiệu lực.</p>
                </div>
                <span id="coreComboStatus" class="rounded-full border border-amber-300 bg-amber-50 px-3 py-1 text-label-sm font-semibold text-amber-800">Core Combo chưa kiểm tra</span>
            </header>
            <div class="overflow-x-auto">
                <table class="w-full min-w-[980px] border-collapse text-left">
                    <thead class="bg-surface-container-low text-label-sm uppercase tracking-wide text-on-surface-variant">
                        <tr>
                            <th class="px-3 py-3 text-center">#</th><th class="px-3 py-3">Dịch vụ / Nhóm</th><th class="px-3 py-3">Diễn giải</th><th class="px-3 py-3 text-center">Số lượng / ĐVT</th><th class="px-3 py-3 text-right">Đơn giá</th><th class="px-3 py-3 text-right">Thành tiền</th><th class="px-3 py-3">PriceFrame</th><th class="px-3 py-3"></th>
                        </tr>
                    </thead>
                    <tbody id="specItemsBody" class="divide-y divide-outline-variant/30 text-body-sm">
                        <tr><td colspan="8" class="p-8 text-center text-on-surface-variant">Đang tải đặc tả…</td></tr>
                    </tbody>
                    <tfoot class="border-t border-outline-variant/40 bg-surface-container-low">
                        <tr><td colspan="5" class="px-4 py-4 text-right font-semibold text-on-surface">Tổng cộng đặc tả</td><td id="specTableTotal" class="px-4 py-4 text-right font-bold text-primary">—</td><td colspan="2"></td></tr>
                    </tfoot>
                </table>
            </div>
            <div class="flex flex-col gap-2 border-t border-outline-variant/30 p-5 text-sm sm:flex-row sm:items-start">
                <span class="material-symbols-outlined text-secondary">info</span>
                <p class="text-on-surface-variant">Core Combo bắt buộc gồm Sảnh, Ẩm thực, Trang trí, MC và Âm thanh &amp; ánh sáng. Cần hoàn tất các mục bắt buộc và xử lý mọi cảnh báo PriceFrame trước khi đóng băng.</p>
            </div>
        </section>

        <section class="rounded-xl border border-outline-variant/30 bg-white p-5 shadow-sm">
            <div class="flex flex-col justify-between gap-3 sm:flex-row sm:items-center">
                <div><h2 class="font-title-md text-title-md text-primary">Sau khi đóng băng</h2><p class="mt-1 text-body-sm text-on-surface-variant">Hệ thống sẽ khóa đặc tả gốc v1 và tạo roadmap cho dự án.</p></div>
                <div class="flex flex-wrap gap-2 text-xs"><span class="rounded-full bg-surface-container-low px-3 py-1">T-90</span><span class="rounded-full bg-surface-container-low px-3 py-1">T-30</span><span class="rounded-full bg-surface-container-low px-3 py-1">T-7</span><span class="rounded-full bg-surface-container-low px-3 py-1">Event Day</span></div>
            </div>
        </section>
    </main>

    <div id="catalogModal" class="hidden fixed inset-0 z-50 items-center justify-center bg-[#2B2625]/50 p-4" role="dialog" aria-modal="true" aria-labelledby="catalogTitle">
        <div class="max-h-[85vh] w-full max-w-2xl overflow-hidden rounded-xl border border-outline-variant/40 bg-white shadow-xl">
            <header class="flex items-center justify-between border-b border-outline-variant/30 p-5"><div><h2 id="catalogTitle" class="font-headline-sm text-headline-sm text-primary">Chọn dịch vụ từ Catalog</h2><p class="mt-1 text-body-sm text-on-surface-variant">Chỉ hiển thị dịch vụ đang hoạt động và chưa có trong đặc tả.</p></div><button type="button" data-close-modal="catalogModal" class="rounded-lg p-2 text-on-surface-variant hover:bg-surface-container-low" aria-label="Đóng">✕</button></header>
            <div id="catalogItems" class="max-h-[60vh] space-y-2 overflow-y-auto p-5"><p class="text-sm text-on-surface-variant">Đang tải Catalog…</p></div>
            <footer class="flex justify-end border-t border-outline-variant/30 bg-surface-container-low p-4"><button type="button" data-close-modal="catalogModal" class="rounded-lg border border-outline-variant px-4 py-2 text-sm font-medium text-on-surface-variant hover:bg-white">Đóng</button></footer>
        </div>
    </div>

    <div id="freezeModal" class="hidden fixed inset-0 z-50 items-center justify-center bg-[#2B2625]/50 p-4" role="dialog" aria-modal="true" aria-labelledby="freezeTitle">
        <div class="w-full max-w-lg overflow-hidden rounded-xl border border-outline-variant/40 bg-white shadow-xl">
            <header class="flex items-start justify-between border-b border-outline-variant/30 p-5"><div><h2 id="freezeTitle" class="font-headline-sm text-headline-sm text-primary">Xác nhận đóng băng Baseline v1</h2><p class="mt-1 text-body-sm text-on-surface-variant">Hệ thống sẽ lưu đặc tả hiện tại trước khi khóa.</p></div><button type="button" data-close-modal="freezeModal" class="rounded-lg p-2 text-on-surface-variant hover:bg-surface-container-low" aria-label="Đóng">✕</button></header>
            <div class="space-y-4 p-5"><p class="rounded-lg border border-amber-200 bg-amber-50 p-3 text-sm text-amber-900">Sau khi đóng băng, không thể sửa trực tiếp đặc tả gốc. Thay đổi về sau phải đi qua Change Request.</p><label class="flex cursor-pointer items-start gap-3 text-sm text-on-surface"><input id="freezeConsent" type="checkbox" class="mt-0.5 rounded border-outline-variant text-primary focus:ring-primary"><span>Tôi xác nhận đặc tả và đơn giá đã được kiểm tra để khóa Baseline v1.</span></label></div>
            <footer class="flex justify-end gap-2 border-t border-outline-variant/30 bg-surface-container-low p-4"><button type="button" data-close-modal="freezeModal" class="rounded-lg border border-outline-variant px-4 py-2 text-sm font-medium text-on-surface-variant hover:bg-white">Quay lại</button><button type="button" id="confirmFreezeBtn" disabled class="rounded-lg bg-primary px-4 py-2 text-sm font-semibold text-white opacity-50">Lưu &amp; đóng băng</button></footer>
        </div>
    </div>
</div>
