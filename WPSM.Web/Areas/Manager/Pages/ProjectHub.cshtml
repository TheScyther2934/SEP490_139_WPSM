        document.querySelectorAll('[aria-label="Tabs dự án"] button').forEach(el => {
          el.classList.remove('border-primary', 'text-primary', 'bg-surface-container-low/40', 'font-bold');
          el.classList.add('border-transparent', 'text-on-surface-variant');
        });
        this.classList.add('border-primary', 'text-primary', 'bg-surface-container-low/40', 'font-bold');
        this.classList.remove('border-transparent', 'text-on-surface-variant');
      });
    });
